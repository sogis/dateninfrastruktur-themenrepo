INTERLIS 2.4;

/** Katalog und Strukturdefinitionen der Dateninfrastruktur.
 *
 * EINFACHE CSV-MODELLE:
 * DataSchema(kind=simple_csv), AttributeDefinition und UniqueDefinition sind
 * die bearbeitbare Quelle im Fachamts-GUI. Daraus wird eine .ili-Datei erzeugt.
 * Der Generator prueft das Ergebnis mit dem Compiler; es gibt keinen separaten
 * Freigabeschritt fuer Strukturaenderungen. Die erzeugte Datei wird nicht
 * unabhaengig von den GUI-Angaben gepflegt.
 *
 * EXTERNE INTERLIS-MODELLE:
 * DataSchema(kind=interlis) referenziert die externe .ili-Datei. Fuer diesen
 * Fall werden keine AttributeDefinition/UniqueDefinition-Objekte gepflegt.
 *
 * Ein Speichern kann automatisch eine neue Schemafassung erzeugen und den
 * Verweis an der Ausgabe umstellen. Alte Versionen behalten ihre Schemafassung.
 * Keine Modell-Hashes, JSON-Liefervertraege, Lockdateien oder Modell-Freigaben.
 *
 * publicationStatus=published bedeutet: fachlich zur Publikation freigegeben.
 * Oeffentliche Sichtbarkeit setzt zusaetzlich verwendbare Daten/Dateien voraus;
 * diese Abfrageregel wird nicht als Pflicht zur sofortigen Datenlieferung
 * modelliert. accessLevel=restricted bleibt davon unabhaengig.
 */
MODEL SO_AGI_DataInfrastructure_Catalog_20261110 (en)
  AT "https://geo.so.ch/models/AGI" VERSION "2026-11-10" =
  IMPORTS SO_AGI_DataInfrastructure_Organization_20261110;

  DOMAIN
    Identifier = TEXT*255;
    AccessLevel = (open, restricted);
    PublicationStatus = (draft, in_review, published, archived);
    DatasetKind = (standalone, series);
    !! Angenommene Datenstaende bzw. Dateien; keine Runner-Zwischenzustaende.
    Availability = (available, withdrawn);
    InputFormat = (csv, xtf);
    DeliveryModes = (replace_only, append_only, replace_and_append);
    SchemaKind = (simple_csv, interlis);
    SimpleType = (text, mtext, integer, decimal, boolean, date, datetime, enumeration);
    NumericLimit = -999999999999999999.999999999 .. 999999999999999999.999999999;
    DistributionFormat = (csv, xlsx, parquet, other);
    Sha256 = TEXT*64;
    SafeFileName = TEXT*128;
    EventTime = FORMAT INTERLIS.XMLDateTime "1582-01-01T00:00:00.000" .. "2999-12-31T23:59:59.999";
    NonNegative = 0 .. 999999999999999999;
    Positive = 1 .. 999999999;
    Origin = (
      !!@ ili2db.dispName=Bund
      federal,
      !!@ ili2db.dispName=Kanton
      cantonal,
      !!@ ili2db.dispName=Gemeinde
      municipal,
      !!@ ili2db.dispName=Weitere
      other
    );
    MaintenanceFrequencyCode = (
      !!@ ili2db.dispName=kontinuierlich
      continual,
      !!@ ili2db.dispName=täglich
      daily,
      !!@ ili2db.dispName=wöchentlich
      weekly,
      !!@ ili2db.dispName=zweiwöchentlich
      biweekly,
      !!@ ili2db.dispName=monatlich
      monthly,
      !!@ ili2db.dispName=quartalsweise
      quarterly,
      !!@ ili2db.dispName=halbjährlich
      biannually,
      !!@ ili2db.dispName=jährlich
      annually,
      !!@ ili2db.dispName="bei Bedarf"
      asNeeded,
      !!@ ili2db.dispName=unregelmässig
      irregular,
      !!@ ili2db.dispName="nicht geplant"
      notPlanned,
      !!@ ili2db.dispName=unbekannt
      unknown
    );
    Theme = (
      !!@ ili2db.dispName="Arbeit und Erwerb"
      Arbeit_Erwerb,
      !!@ ili2db.dispName="Bau- und Wohnungswesen"
      Bau_und_Wohnungswesen,
      !!@ ili2db.dispName=Bevölkerung
      Bevoelkerung,
      !!@ ili2db.dispName="Bildung und Wissenschaft"
      Bildung_Wissenschaft,
      !!@ ili2db.dispName=Energie
      Energie,
      !!@ ili2db.dispName=Finanzen
      Finanzen,
      !!@ ili2db.dispName=Geografie
      Geografie,
      !!@ ili2db.dispName=Gesetzgebung
      Gesetzgebung,
      !!@ ili2db.dispName=Gesundheit
      Gesundheit,
      !!@ ili2db.dispName=Handel
      Handel,
      !!@ ili2db.dispName="Industrie und Dienstleistungen"
      Industrie_und_Dienstleistungen,
      !!@ ili2db.dispName="Kriminalität und Strafrecht"
      Kriminalitaet_Strafrecht,
      !!@ ili2db.dispName="Kultur, Medien, Informationsgesellschaft und Sport"
      Kultur_Medien_Informationsgesellschaft_Sport,
      !!@ ili2db.dispName="Landwirtschaft und Forstwirtschaft"
      Landwirtschaft_Forstwirtschaft,
      !!@ ili2db.dispName="Mobilität und Verkehr"
      Mobilitaet_und_Verkehr,
      !!@ ili2db.dispName="Öffentliche Ordnung und Sicherheit"
      Oeffentliche_Ordnung_und_Sicherheit,
      !!@ ili2db.dispName=Politik
      Politik,
      !!@ ili2db.dispName=Preise
      Preise,
      !!@ ili2db.dispName="Raum und Umwelt"
      Raum_und_Umwelt,
      !!@ ili2db.dispName="Soziale Sicherheit"
      Soziale_Sicherheit,
      !!@ ili2db.dispName="Statistische Grundlagen"
      Statistische_Grundlagen,
      !!@ ili2db.dispName=Tourismus
      Tourismus,
      !!@ ili2db.dispName=Verwaltung
      Verwaltung,
      !!@ ili2db.dispName=Volkswirtschaft
      Volkswirtschaft
    );

  TOPIC Catalog =
    OID AS INTERLIS.UUIDOID;
    DEPENDS ON SO_AGI_DataInfrastructure_Organization_20261110.Organization;

    /** Wiederverwendbare Kontaktstelle. Keine notwendige Beziehung zu Office.
     * Aenderungen gelten unmittelbar fuer alle referenzierenden Datensaetze.
     * active=false verhindert nur neue Zuweisungen, loescht keine Beziehungen.
     */
    !!@ di.audit=full
    CLASS ContactPoint =
      name : MANDATORY TEXT*255;
      kind : MANDATORY (organization, individual);
      email : MANDATORY INTERLIS.URI;
      phone : TEXT*64;
      url : INTERLIS.URI;
      organizationName : TEXT*255;
      organizationUnit : TEXT*255;
      active : MANDATORY BOOLEAN;
    END ContactPoint;

    !!@ di.audit=full
    CLASS Dataset =
      identifier : MANDATORY Identifier;
      kind : MANDATORY DatasetKind;
      title : MANDATORY TEXT*255;
      description : MANDATORY MTEXT;
      themes : BAG {0..*} OF Theme;
      keywords : BAG {0..*} OF TEXT*255;
      accessLevel : MANDATORY AccessLevel;
      publicationStatus : MANDATORY PublicationStatus;
      origin : Origin;
      frequency : MaintenanceFrequencyCode;
      issued : DATE;
      modified : MANDATORY DATE;
      licenseUri : INTERLIS.URI;
      surveyMethod : MTEXT;
      furtherUses : MTEXT;
      auxiliaryData : MTEXT;
      dataAvailableFrom : TEXT*255;
      UNIQUE identifier;
    END Dataset;

    /** Fachliche Ausgabe. standalone besitzt genau eine interne Ausgabe
     * mit issueKey=default. Diese wird im GUI nicht als Serie dargestellt.
     * schema bezeichnet die fuer neue Lieferungen vorgesehene Datenstruktur.
     */
    !!@ di.audit=full
    CLASS DatasetIssue =
      issueKey : MANDATORY TEXT*128;
      label : MANDATORY TEXT*255;
      publicationStatus : MANDATORY PublicationStatus;
      referenceDate : DATE;
      startDate : DATE;
      endDate : DATE;
      note : MTEXT;
      issued : DATE;
      modified : MANDATORY DATE;
      MANDATORY CONSTRAINT ReferenceOrInterval:
        NOT (DEFINED(referenceDate) AND (DEFINED(startDate) OR DEFINED(endDate)));
      MANDATORY CONSTRAINT OrderedInterval:
        NOT (DEFINED(startDate) AND DEFINED(endDate)) OR startDate <= endDate;
    END DatasetIssue;

    /** Eine konkrete Datenstruktur / Modellfassung, kein Liefervertrag.
     * simple_csv: Bearbeitung im GUI, anschliessend automatisch .ili erzeugen.
     * interlis: Externes INTERLIS-Modell ist die bearbeitbare Quelle.
     * modelName ist eindeutig und bezeichnet eine konkrete Modellfassung.
     * modelUri ist ein optionaler Ablagehinweis, kein frei waehlbares Jobziel.
     * minimumObjectCount ist NUR eine Eingabe fuer den CSV-Modellgenerator:
     * gesetzt => SET CONSTRAINT (BASKET) INTERLIS.objectCount(ALL) >= n;
     * undefiniert => keine Mindestmengenbedingung. Keine weitere Laufzeitregel.
     */
    !!@ di.audit=full
    CLASS DataSchema =
      identifier : MANDATORY Identifier;
      kind : MANDATORY SchemaKind;
      modelName : MANDATORY TEXT*255;
      modelVersion : TEXT*100;
      modelUri : INTERLIS.URI;
      description : MTEXT;
      minimumObjectCount : Positive;
      UNIQUE identifier;
      UNIQUE modelName;
      MANDATORY CONSTRAINT GeneratedMinimumOnly:
        kind == #simple_csv OR NOT (DEFINED(minimumObjectCount));
    END DataSchema;

    /** Betriebliche Lieferoptionen, keine Kopie der Datenstruktur.
     * CSV-Konventionen gelten systemweit. xtf bezeichnet die kuenftige
     * Lieferart; daraus folgt noch keine implementierte XTF-Verarbeitung.
     * enabled=false stoppt Lieferungen, nicht den Abruf vorhandener Daten.
     */
    !!@ di.audit=full
    CLASS DeliveryConfiguration =
      enabled : MANDATORY BOOLEAN;
      format : MANDATORY InputFormat;
      allowedModes : MANDATORY DeliveryModes;
    END DeliveryConfiguration;

    /** Eingabe des einfachen CSV-Modelleditors, NICHT parallel zur .ili-Datei
     * editierbare Metadaten eines externen Modells.
     * ordinal bestimmt die Attributreihenfolge. enumValues sind einfache
     * INTERLIS-Codes; zulaessige Namen prueft der Generator/Compiler.
     * numericMinimum/Maximum + decimalPlaces beschreiben numerische Typen;
     * integer hat 0 Nachkommastellen. maxLength gilt fuer TEXT/MTEXT.
     * unit und codeList sind beschreibende Angaben, kein Einheitenrechner
     * und kein automatisch aktivierter externer Wertebereich.
     */
    !!@ di.audit=full
    CLASS AttributeDefinition =
      name : MANDATORY TEXT*255;
      dataType : MANDATORY SimpleType;
      ordinal : MANDATORY Positive;
      mandatory : MANDATORY BOOLEAN;
      description : MTEXT;
      unit : TEXT*255;
      codeList : INTERLIS.URI;
      maxLength : 1 .. 32767;
      numericMinimum : NumericLimit;
      numericMaximum : NumericLimit;
      decimalPlaces : 0 .. 9;
      dateMinimum : DATE;
      dateMaximum : DATE;
      dateTimeMinimum : EventTime;
      dateTimeMaximum : EventTime;
      enumValues : LIST {0..*} OF TEXT*255;

      MANDATORY CONSTRAINT TextLengthRequired:
        (dataType == #text OR dataType == #mtext) == DEFINED(maxLength);
      MANDATORY CONSTRAINT NumericParameters:
        ((dataType == #integer OR dataType == #decimal)
          AND DEFINED(numericMinimum) AND DEFINED(numericMaximum) AND DEFINED(decimalPlaces))
        OR ((dataType != #integer AND dataType != #decimal)
          AND NOT (DEFINED(numericMinimum) OR DEFINED(numericMaximum) OR DEFINED(decimalPlaces)));
      MANDATORY CONSTRAINT NumericInterval:
        NOT (DEFINED(numericMinimum) AND DEFINED(numericMaximum)) OR numericMinimum <= numericMaximum;
      MANDATORY CONSTRAINT IntegerPrecision:
        dataType != #integer OR decimalPlaces == 0;
      MANDATORY CONSTRAINT DecimalPrecision:
        dataType != #decimal OR decimalPlaces > 0;
      MANDATORY CONSTRAINT DateBoundsOnly:
        dataType == #date OR NOT (DEFINED(dateMinimum) OR DEFINED(dateMaximum));
      MANDATORY CONSTRAINT DateInterval:
        NOT (DEFINED(dateMinimum) AND DEFINED(dateMaximum)) OR dateMinimum <= dateMaximum;
      MANDATORY CONSTRAINT DateTimeBoundsOnly:
        dataType == #datetime OR NOT (DEFINED(dateTimeMinimum) OR DEFINED(dateTimeMaximum));
      MANDATORY CONSTRAINT DateTimeInterval:
        NOT (DEFINED(dateTimeMinimum) AND DEFINED(dateTimeMaximum)) OR dateTimeMinimum <= dateTimeMaximum;
    END AttributeDefinition;

    /** Ein einfacher oder zusammengesetzter UNIQUE-Constraint im generierten
     * CSV-Modell. Mehrere Regeln sind erlaubt und gelten alle zugleich.
     * Dies ist keine separate Upsert-/businessKey-Definition.
     */
    !!@ di.audit=full
    CLASS UniqueDefinition =
      name : MANDATORY TEXT*128;
      description : MTEXT;
    END UniqueDefinition;

    /** Beteiligtes Attribut einer UNIQUE-Regel. Die echte Assoziation
     * verhindert unaufloesbare Attributnamen nach Umbenennungen im Editor.
     */
    !!@ di.audit=full
    CLASS UniqueField =
      ordinal : MANDATORY Positive;
    END UniqueField;

    /** Vollstaendiger angenommener Datenstand einer Ausgabe. Auch Append
     * erzeugt einen neuen vollstaendigen Snapshot; die Basis bleibt bestehen.
     * objectCount und attributeCount sind reine Mess-/Anzeigewerte. Insbesondere
     * gibt es hier KEIN objectCount > 0 und keinen allowEmptyReplacement-Schalter.
     * schema bezeichnet die tatsaechlich fuer diese Version verwendete Fassung.
     */
    !!@ di.audit=full
    CLASS DataVersion =
      versionKey : MANDATORY TEXT*128;
      sequence : MANDATORY Positive;
      availability : MANDATORY Availability;
      acceptedAt : MANDATORY EventTime;
      sourceSha256 : Sha256;
      objectCount : NonNegative;
      attributeCount : NonNegative;
      validationStatus : MANDATORY (unknown, success, fail);
      validationAt : EventTime;
      validationErrors : NonNegative;
      validationReportKey : TEXT*1024;
      sourceReference : TEXT*1024;
      MANDATORY CONSTRAINT AvailableVersionValidated:
        availability != #available OR validationStatus == #success;
    END DataVersion;

    /** Konkrete Ausgabedatei. Groesse und Hash stammen aus dem Runner-Ergebnis
     * und werden durch das Backend gespeichert. objectKey ist der private
     * Storage-Schluessel, keine oeffentliche URL und keine Zugriffsberechtigung.
     */
    !!@ di.audit=full
    CLASS Distribution =
      format : MANDATORY DistributionFormat;
      fileName : MANDATORY SafeFileName;
      mediaType : MANDATORY TEXT*255;
      availability : MANDATORY Availability;
      byteSize : NonNegative;
      sha256 : Sha256;
      objectKey : MANDATORY TEXT*1024;
      UNIQUE objectKey;
      MANDATORY CONSTRAINT AvailableFileMeasured:
        availability != #available OR (DEFINED(byteSize) AND DEFINED(sha256));
    END Distribution;

    !!@ di.audit=full
    ASSOCIATION DatasetOwner =
      ownerOffice (EXTERNAL) -- {1} SO_AGI_DataInfrastructure_Organization_20261110.Organization.Office;
      ownedDatasets -- {0..*} Dataset;
    END DatasetOwner;

    !!@ di.audit=full
    ASSOCIATION DatasetPublisher =
      publisherOffice (EXTERNAL) -- {1} SO_AGI_DataInfrastructure_Organization_20261110.Organization.Office;
      publishedDatasets -- {0..*} Dataset;
    END DatasetPublisher;

    !!@ di.audit=full
    ASSOCIATION DatasetContact =
      contactPoint -- {1} ContactPoint;
      datasets -- {0..*} Dataset;
    END DatasetContact;

    !!@ di.audit=full
    ASSOCIATION IssueDataset =
      dataset -- {1} Dataset;
      issues -- {0..*} DatasetIssue;
    END IssueDataset;

    /** Entwuerfe duerfen zunaechst noch ohne Struktur angelegt werden.
     * Vor einer Anlieferung muss eine verwendbare Struktur ausgewaehlt sein.
     */
    !!@ di.audit=full
    ASSOCIATION IssueSchema =
      schema -- {0..1} DataSchema;
      usingIssues -- {0..*} DatasetIssue;
    END IssueSchema;

    !!@ di.audit=full
    ASSOCIATION VersionIssue =
      issue -- {1} DatasetIssue;
      versions -- {0..*} DataVersion;
    END VersionIssue;

    !!@ di.audit=full
    ASSOCIATION DistributionVersion =
      version -- {1} DataVersion;
      distributions -- {0..*} Distribution;
    END DistributionVersion;

    !!@ di.audit=full
    ASSOCIATION VersionSchema =
      schema -- {1} DataSchema;
      usingVersions -- {0..*} DataVersion;
    END VersionSchema;

    !!@ di.audit=full
    ASSOCIATION AttributeSchema =
      schema -- {1} DataSchema;
      attributes -- {0..*} AttributeDefinition;
    END AttributeSchema;

    !!@ di.audit=full
    ASSOCIATION UniqueSchema =
      schema -- {1} DataSchema;
      uniqueDefinitions -- {0..*} UniqueDefinition;
    END UniqueSchema;

    !!@ di.audit=full
    ASSOCIATION UniqueRuleFields =
      uniqueDefinition -- {1} UniqueDefinition;
      fields -- {1..*} UniqueField;
    END UniqueRuleFields;

    !!@ di.audit=full
    ASSOCIATION UniqueFieldAttribute =
      attribute -- {1} AttributeDefinition;
      uniqueFields -- {0..*} UniqueField;
    END UniqueFieldAttribute;

    !!@ di.audit=full
    ASSOCIATION CurrentIssue =
      currentIssue -- {0..1} DatasetIssue;
      currentForDatasets -- {0..*} Dataset;
    END CurrentIssue;

    !!@ di.audit=full
    ASSOCIATION CurrentVersion =
      currentVersion -- {0..1} DataVersion;
      currentForIssues -- {0..*} DatasetIssue;
    END CurrentVersion;

    !!@ di.audit=full
    ASSOCIATION DeliveryDataset =
      dataset -- {1} Dataset;
      deliveryConfiguration -- {0..1} DeliveryConfiguration;
    END DeliveryDataset;

    CONSTRAINTS OF DeliveryConfiguration =
      UNIQUE dataset;
    END;
    CONSTRAINTS OF Dataset =
      MANDATORY CONSTRAINT CurrentIssueBelongsToDataset:
        NOT (DEFINED(currentIssue)) OR currentIssue->dataset->identifier == identifier;
    END;
    CONSTRAINTS OF DatasetIssue =
      UNIQUE dataset, issueKey;
      MANDATORY CONSTRAINT StandaloneIssueKey:
        dataset->kind != #standalone OR issueKey == "default";
      MANDATORY CONSTRAINT CurrentVersionBelongsToIssue:
        NOT (DEFINED(currentVersion)) OR
        (currentVersion->issue->issueKey == issueKey
          AND currentVersion->issue->dataset->identifier == dataset->identifier);
      MANDATORY CONSTRAINT CurrentVersionAvailable:
        NOT (DEFINED(currentVersion)) OR currentVersion->availability == #available;
    END;
    CONSTRAINTS OF DataVersion =
      UNIQUE issue, versionKey;
      UNIQUE issue, sequence;
    END;
    CONSTRAINTS OF AttributeDefinition =
      UNIQUE schema, name;
      UNIQUE schema, ordinal;
      MANDATORY CONSTRAINT OnlyGeneratedAttributes:
        schema->kind == #simple_csv;
    END;
    CONSTRAINTS OF UniqueDefinition =
      UNIQUE schema, name;
      MANDATORY CONSTRAINT OnlyGeneratedUniqueRules:
        schema->kind == #simple_csv;
    END;
    CONSTRAINTS OF UniqueField =
      UNIQUE uniqueDefinition, attribute;
      UNIQUE uniqueDefinition, ordinal;
      MANDATORY CONSTRAINT SameSchema:
        uniqueDefinition->schema->identifier == attribute->schema->identifier;
    END;

  END Catalog;
END SO_AGI_DataInfrastructure_Catalog_20261110.